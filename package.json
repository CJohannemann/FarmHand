{
  "name": "farmhand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:db": "node db/test/verify.mjs",
    "verify:sync": "node db/test/verify-sync.mjs",
    "verify": "npm run verify:db && npm run verify:sync && npm run verify:roundtrip && npm run verify:weather && npm run verify:tiles",
    "verify:roundtrip": "node --experimental-strip-types db/test/verify-roundtrip.ts",
    "verify:weather": "node --experimental-strip-types db/test/verify-weather.ts",
    "verify:tiles": "node --experimental-strip-types db/test/verify-tiles.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@electric-sql/pglite": "^0.2.17",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^0.15.5",
    "typescript": "~5.8.3",
    "vite": "^6.0.7"
  }
}
