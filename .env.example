# Copy this file to .env and fill in the two values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Both of these are safe to ship inside the app. They are restricted by the
# row-level security policies in db/schema.sql.
#
# NEVER put the service_role key or the database password in here. Those
# bypass all security rules. They are not needed by this app.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
