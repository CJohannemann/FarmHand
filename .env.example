# Copy this file to .env and fill in the two values for the backend this
# build should talk to. For the self-hosted stack (what the live site runs),
# both come out of deploy/selfhost/.env:
#
#   VITE_SUPABASE_URL       -> https://<API_DOMAIN>
#   VITE_SUPABASE_ANON_KEY  -> the ANON_KEY value
#
# These are baked into the bundle at build time, not read at runtime, so
# changing either one means a rebuild and redeploy — not just a restart.
#
# Both are safe to ship inside the app. They are restricted by the row-level
# security policies in db/schema.sql.
#
# NEVER put the service_role key or the database password in here. Those
# bypass all security rules. They are not needed by this app.

VITE_SUPABASE_URL=https://api.farmhandmanager.com
VITE_SUPABASE_ANON_KEY=your-anon-public-key
