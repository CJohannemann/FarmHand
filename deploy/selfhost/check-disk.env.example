# Copy to check-disk.env and fill in whichever notification channel you
# actually want to use — both are optional, and check-disk.sh works (just
# logging, no notification) with neither set.

# Percent full before a warning fires. Default in the script is 80.
#THRESHOLD=80

# ntfy.sh: free, no account. Pick any hard-to-guess topic name (anyone who
# knows it can read your alerts, since public ntfy.sh topics aren't
# private) — subscribe to the same name in the ntfy app on your phone.
#NTFY_TOPIC=farmhand-vps-yourrandomwordshere

# Only if self-hosting ntfy yourself instead of using ntfy.sh:
#NTFY_URL=https://ntfy.example.com

# Requires `mail`/`mailx` installed and a working local MTA already set up
# on this VPS (most stock Ubuntu images do not have one out of the box).
#MAIL_TO=you@example.com
