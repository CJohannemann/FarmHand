# Copy to .env in this same folder and fill in every value.
#
#   cp .env.example .env

# --------------------------------------------------------------- domains --
# The frontend is deployed at farmhandmanager.com
# (see ../README.md). This is a *second* subdomain, just for this backend.
FRONTEND_DOMAIN=farmhandmanager.com
API_DOMAIN=api.farmhandmanager.com

# ---------------------------------------------------------------- secrets --
# Generate both with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Mint these two AFTER filling in JWT_SECRET above, with:
#   node mint-jwt.mjs "<the JWT_SECRET value>" anon
#   node mint-jwt.mjs "<the JWT_SECRET value>" service_role
#
# ANON_KEY is what goes in FarmHand's own .env as VITE_SUPABASE_ANON_KEY —
# safe to expose in the browser bundle, same as the current Supabase one.
# SERVICE_ROLE_KEY bypasses row-level security entirely. Nothing here needs
# it; keep it out of the frontend and don't paste it anywhere client-side.
ANON_KEY=
SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ SMTP --
# Confirmation and password-reset emails need a real mail provider — GoTrue
# can't send anything without one. Using Brevo's free tier:
#   1. Brevo dashboard -> Settings (gear) -> SMTP & API -> SMTP tab for the
#      server/port/login, and an SMTP key (not your account password).
#   2. Settings -> Senders, Domains & Dedicated IPs -> Senders: verify the
#      address you put in SMTP_ADMIN_EMAIL below — Brevo rejects mail from
#      an unverified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
