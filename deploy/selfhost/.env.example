# Copy to .env in this same folder and fill in every value.
#
#   cp .env.example .env

# --------------------------------------------------------------- domains --
# The frontend is already deployed at farmhand.independencebaseballclub.com
# (see ../README.md). This is a *second* subdomain, just for this backend.
FRONTEND_DOMAIN=farmhand.independencebaseballclub.com
API_DOMAIN=api.independencebaseballclub.com

# ---------------------------------------------------------------- secrets --
# Generate both with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Mint these two AFTER filling in JWT_SECRET above, with:
#   node mint-jwt.mjs "<the JWT_SECRET value>" anon
#   node mint-jwt.mjs "<the JWT_SECRET value>" service_role
#
# ANON_KEY is what goes in FarmHand's own .env as VITE_SUPABASE_ANON_KEY —
# safe to expose in the browser bundle, same as the current Supabase one.
# SERVICE_ROLE_KEY bypasses row-level security entirely. Nothing here needs
# it; keep it out of the frontend and don't paste it anywhere client-side.
ANON_KEY=
SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ SMTP --
# Password-reset emails need a real mail provider — GoTrue can't send
# anything without one. A free tier from Brevo, Resend, or Mailgun works,
# or Gmail with an app password (not your normal password) for low volume.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
