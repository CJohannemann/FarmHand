[Unit]
Description=Push a FarmHand database dump to the home server
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Adjust User= and WorkingDirectory= if FarmHand isn't cloned under this
# user's home. The user must be able to run `docker compose` (in the docker
# group) and must own the SSH key named in backup.env.
User=ubuntu
WorkingDirectory=/home/ubuntu/FarmHand/deploy/backup
ExecStart=/usr/bin/bash push-backup.sh
