# Copy to backup.env on whichever machine runs the script that reads it.
# push-backup.sh reads the top block (on the VPS); rotate-backups.sh reads
# the bottom block (on the home server). Keeping one example file means one
# place to look, not two half-documented ones.

# ---------------------------------------------------------------- VPS side

# Where to push. The user here is the restricted account on the home server
# whose authorized_keys pins receive-backup.sh as a forced command.
#BACKUP_SSH_TARGET=farmhand@home.example.net

# Private key on the VPS. Generate with:
#   ssh-keygen -t ed25519 -N '' -f ~/.ssh/farmhand_backup -C farmhand-vps
#BACKUP_SSH_KEY=/home/ubuntu/.ssh/farmhand_backup

# If your router forwards something other than 22 to the home server.
#BACKUP_SSH_PORT=22

# Push .env and docker-compose.yml alongside the database. Strongly
# recommended: without JWT_SECRET a restored database cannot validate a
# single existing session. Set to 0 only if you archive those another way.
#BACKUP_INCLUDE_CONFIG=1

# --------------------------------------------------------------- home side

#FARMHAND_BACKUP_ROOT=/srv/farmhand-backup
#FARMHAND_BACKUP_DROP=/srv/farmhand-backup/drop
#FARMHAND_BACKUP_ARCHIVE=/srv/farmhand-backup/archive

# Grandfather-father-son retention. With ~200KB per receipt image and a
# 1.5TB disk, being generous here costs almost nothing — and hard links mean
# a dump kept as both weekly and monthly is stored once.
#KEEP_DAILY=14
#KEEP_WEEKLY=8
#KEEP_MONTHLY=12

# Warn if the newest archived dump is older than this. Catches the failure
# that looks like success: a push that quietly stopped weeks ago.
#STALE_HOURS=36

# Refuse to archive a dump smaller than this — a dump of an empty database
# is only a few KB and otherwise looks like a healthy backup.
#FARMHAND_BACKUP_MIN_BYTES=51200

# ------------------------------------------------------------ notifications
# Same channels as deploy/selfhost/check-disk.sh. Set on both machines if you
# want to hear about both push failures and stale/corrupt archives.
#NTFY_TOPIC=farmhand-backup-yourrandomwordshere
#NTFY_URL=https://ntfy.example.com
#MAIL_TO=you@example.com
